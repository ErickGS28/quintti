# Copy this file to .env.local and adjust. Only NEXT_PUBLIC_* values reach the browser,
# and nothing here is secret: never put keys or seed phrases in an env file.

# "testnet" or "local" (a local Stellar quickstart). Mainnet is not supported.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional. Defaults to the public testnet RPC (or the local quickstart RPC).
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# The deployed treasury contract (starts with C). This is the demo deployment from the README;
# the testnet is reset periodically, so run scripts/seed-demo.ps1 for your own if it is gone.
NEXT_PUBLIC_TREASURY_CONTRACT_ID=CA67PF3REYJWLXK7WE2OKEJMX42A76LCUQWL4PAU2TV2IRO5BSFLWZKR

# How amounts of the treasury's token are shown. The demo deployment pays in native XLM.
NEXT_PUBLIC_TOKEN_SYMBOL=XLM
NEXT_PUBLIC_TOKEN_DECIMALS=7
