# Copy this file to .env.local and adjust. Only NEXT_PUBLIC_* values reach the browser,
# and nothing here is secret: never put keys or seed phrases in an env file.

# "testnet" or "local" (a local Stellar quickstart). Mainnet is not supported.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional. Defaults to the public testnet RPC (or the local quickstart RPC).
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# The deployed treasury contract (starts with C). This is the development deployment
# from the README; the testnet is reset periodically, so deploy your own if it is gone.
NEXT_PUBLIC_TREASURY_CONTRACT_ID=CAQ6YXC6L3G2YVBWW52IPDNVBRCDMUO3S463MQL5HD2KGNDCOT5NCHDA

# How amounts of the treasury's token are shown. The development deployment pays in native XLM.
NEXT_PUBLIC_TOKEN_SYMBOL=XLM
NEXT_PUBLIC_TOKEN_DECIMALS=7
