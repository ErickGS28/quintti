# Copy this file to .env.local and adjust. Only NEXT_PUBLIC_* values reach the browser,
# and nothing here is secret: never put keys or seed phrases in an env file.

# "testnet", "local" (a local Stellar quickstart) or "mainnet". Mainnet needs NEXT_PUBLIC_SOROBAN_RPC_URL
# (an https URL from an RPC provider: the SDF runs no public one) and is an unaudited beta, see
# docs/decisions/0018-mainnet-as-an-opt-in-beta.md.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional. Defaults to the public testnet RPC (or the local quickstart RPC).
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# The deployed treasury contract (starts with C). This is the demo deployment from the README;
# the testnet is reset periodically, so run scripts/seed-demo.ps1 for your own if it is gone.
NEXT_PUBLIC_TREASURY_CONTRACT_ID=CCHMX7JMZ7XVKURSR55FSM5MT5SOZOPNTFYQ6SSL5YIIRXKNN5FA5QDP

# How amounts of the treasury's token are shown. The demo deployment pays in native XLM.
NEXT_PUBLIC_TOKEN_SYMBOL=XLM
NEXT_PUBLIC_TOKEN_DECIMALS=7

# Optional. The Ship It vault (docs/decisions/0021-a-vault-for-ship-it.md), shown at /boveda. Without it the page says the vault is not set up.
# NEXT_PUBLIC_VAULT_CONTRACT_ID=C...
